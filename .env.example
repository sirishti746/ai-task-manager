# Copy this file to .env and fill in real values. NEVER commit .env.

# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/task_manager

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Get a key at https://aistudio.google.com (never commit the real one).
# If left empty, only the AI endpoint is affected (it returns 503).
AI_API_KEY=your-gemini-api-key-here
AI_MODEL=gemini-2.5-flash

# Optional (these defaults are used if omitted):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_TIMEOUT_SECONDS=15