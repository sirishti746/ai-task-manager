    {
      "name": "AI",
      "item": [
        {
          "name": "1. Generate description (200 with a valid AI key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/tasks/generate-description",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "tasks",
                "generate-description"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{user_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix login bug\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Needs a valid AI_API_KEY in .env. Without it the API correctly answers 503; if the provider fails it answers 502. This test accepts all three, and checks the body shape for each."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (success), 502 (provider failure) or 503 (not configured)\", function () {",
                  "  pm.expect([200, 502, 503]).to.include(pm.response.code);",
                  "});",
                  "const j = pm.response.json();",
                  "if (pm.response.code === 200) {",
                  "  pm.test(\"Description is non-empty text\", function () {",
                  "    pm.expect(j.description).to.be.a(\"string\").and.not.empty;",
                  "  });",
                  "} else {",
                  "  pm.test(\"Failure is a clean message with no secrets\", function () {",
                  "    pm.expect(j.detail).to.be.a(\"string\");",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
