{
  "info": {
    "name": "AI Task Manager",
    "description": "Run the folders in order (Collection Runner). Requires: server running, migrations applied, and 'python -m app.database.seed' executed. Seeded accounts are for LOCAL TESTING ONLY.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register new user (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"{{new_email}}\",\n  \"password\": \"Postman@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"new_email\", \"pm_\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Role is user and no password fields leak\", function () {",
                  "  pm.expect(j.role).to.eql(\"user\");",
                  "  pm.expect(j).to.not.have.property(\"password\");",
                  "  pm.expect(j).to.not.have.property(\"password_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
