                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 422\", function () { pm.response.to.have.status(422); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Custom error shape, input not echoed\", function () {",
                  "  pm.expect(j.detail).to.eql(\"Validation failed\");",
                  "  pm.expect(j.errors).to.be.an(\"array\").that.is.not.empty;",
                  "  pm.expect(JSON.stringify(j)).to.not.include(\"short\");",
                  "});"
                ]
              }
            }
          ]
        },
